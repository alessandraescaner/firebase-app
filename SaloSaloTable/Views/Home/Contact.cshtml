@{
    ViewBag.Title = "Contact Us";
}

<section class="contact-page">

    <div class="container">

        <!-- CONTACT HEADER -->
        <div class="contact-header center-align">
            <div class="section-label">RESERVE A TABLE</div>

            <h1>Contact Us</h1>
            <h2>Salo-Salo Table</h2>

            <p>
                Have questions, suggestions, or simply want to connect with us?
                We would love to hear from you!
            </p>
        </div>


        <!-- ADDRESS CARD -->
        <div class="row contact-address">

            <div class="col s12">
                <div class="card contact-card">

                    <div class="card-content center-align">

                        <i class="material-icons contact-icon">
                            location_on
                        </i>

                        <span class="card-title">
                           Visit Us
                        </span>

                        <p>
                            Makati City
                        </p>

                    </div>

                </div>
            </div>

        </div>


        <!-- CONTACT CARDS -->
        <div class="row contact-cards">

            <div class="col s12 m4">
                <div class="card contact-card">

                    <div class="card-content center-align">

                        <i class="material-icons contact-icon">
                            phone
                        </i>

                        <span class="card-title">
                            Phone
                        </span>

                        <p>
                            0912 345 6789
                        </p>

                        <a href="tel:09123456789"
                           class="contact-link">
                            Call Us
                        </a>

                    </div>

                </div>
            </div>


            <div class="col s12 m4">
                <div class="card contact-card">

                    <div class="card-content center-align">

                        <i class="material-icons contact-icon">
                            public
                        </i>

                        <span class="card-title">
                            Facebook
                        </span>

                        <p>
                            Salo-Salo Table
                        </p>

                        <a href="#!"
                           class="contact-link">
                            salosalotable
                        </a>

                    </div>

                </div>
            </div>


            <div class="col s12 m4">
                <div class="card contact-card">

                    <div class="card-content center-align">

                        <i class="material-icons contact-icon">
                            photo_camera
                        </i>

                        <span class="card-title">
                            Instagram
                        </span>

                        <p>
                            Follow us on Instagram
                        </p>

                        <a href="#!"
                           class="contact-link">
                            salosalo
                        </a>

                    </div>

                </div>
            </div>

        </div>


        <!-- MESSAGE SECTION -->
        <div class="row contact-message">

            <div class="col s12">
                <div class="card contact-message-card">

                    <div class="card-content center-align">

                        <i class="material-icons contact-message-icon">
                            restaurant
                        </i>

                        <h2>
                            Let's Share a Meal
                        </h2>

                        <p>
                            Salo-Salo Table is all about good food,
                            meaningful conversations, and bringing people together around one table.
                        </p>

                    </div>

                </div>
            </div>

        </div>

    </div>

</section>