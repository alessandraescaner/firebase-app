@{
    ViewBag.Title = "About Us";
}


<section class="about-hero-section">

    <div class="container">

        <div class="about-hero-content">

            <div class="about-hero-label">
                OUR STORY
            </div>

            <h1>
                About Salo-Salo Table
            </h1>

            <div class="about-hero-tagline">
                Good food, good company, one table.
            </div>

            <p class="about-hero-description">
                Salo-Salo Table is a restaurant website created to celebrate
                Filipino food, meaningful conversations, and the joy of
                gathering around one table.
            </p>

        </div>

    </div>

</section>



<section class="goals-section">

    <div class="container">

        <div class="goals-header center-align">

            <div class="section-label">
                OUR BUSINESS
            </div>

            <h2>
                What We Stand For
            </h2>

            <p>
                Salo-Salo Table aims to create a dining experience where
                Filipino food, culture, and connection come together.
            </p>

        </div>


        <div class="row goals-row">

            <div class="col s12 m6 l3">

                <div class="card goal-card">

                    <div class="card-content center-align">

                        <i class="material-icons goal-icon">
                            restaurant
                        </i>

                        <span class="card-title">
                            Celebrate Filipino Food
                        </span>

                        <p>
                            Showcase the richness and variety of Filipino
                            dishes and flavors.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col s12 m6 l3">

                <div class="card goal-card">

                    <div class="card-content center-align">

                        <i class="material-icons goal-icon">
                            groups
                        </i>

                        <span class="card-title">
                            Bring People Together
                        </span>

                        <p>
                            Create a welcoming space where family and friends
                            can enjoy meals together.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col s12 m6 l3">

                <div class="card goal-card">

                    <div class="card-content center-align">

                        <i class="material-icons goal-icon">
                            public
                        </i>

                        <span class="card-title">
                            Support Local Culture
                        </span>

                        <p>
                            Help promote Filipino traditions and culture
                            through food and dining.
                        </p>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>


<hr class="section-divider">





<section class="goals-section">

    <div class="container">

        <div class="goals-header center-align">

            <div class="section-label">
                OUR TEAM
            </div>

            <h2>
                What We Aim For
            </h2>

            <p>
                Salo-Salo Table is designed to provide an appealing and
                functional restaurant website while supporting the client's
                business operations through an employee management system.
            </p>

        </div>


        <div class="row goals-row">

            <div class="col s12 m6 l4">

                <div class="card goal-card">

                    <div class="card-content center-align">

                        <i class="material-icons goal-icon">
                            manage_accounts
                        </i>

                        <span class="card-title">
                            Management System
                        </span>

                        <p>
                            Develop a built-in employee management system that
                            allows the client to manage employee information
                            efficiently.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col s12 m6 l4">

                <div class="card goal-card">

                    <div class="card-content center-align">

                        <i class="material-icons goal-icon">
                            language
                        </i>

                        <span class="card-title">
                            Website Development
                        </span>

                        <p>
                            Develop a functional and appealing website that
                            showcases Filipino food, culture, and the Salo-Salo
                            Table dining experience.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col s12 m6 l4">

                <div class="card goal-card">

                    <div class="card-content center-align">

                        <i class="material-icons goal-icon">
                            person
                        </i>

                        <span class="card-title">
                            About The Developer
                        </span>

                        <p>
                            <strong>
                                Alessandra Loraine S. Escaner
                            </strong>
                        </p>

                        <p>
                            A 3rd-year Information Technology student at the
                            University of Santo Tomas, passionate about web
                            development, design, and creating meaningful
                            digital experiences.
                        </p>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>