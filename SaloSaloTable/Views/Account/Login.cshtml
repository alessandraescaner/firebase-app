@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div ng-app="SaloSaloTableModule"
     ng-controller="LoginController"
     class="login-page">

    <div class="container">

        <div class="row">

            <div class="col s12 m8 l5 offset-m2 offset-l3">

                <div class="card login-card">

                    <div class="card-content">

                        <div class="login-header center-align">

                            <div class="section-label">
                                WELCOME BACK
                            </div>

                            <div class="login-title">

                                <img src="@Url.Content("~/Content/SaloSalo/images/salosalologobrown.png")"
                                     alt="Salo-Salo Table Logo"
                                     class="login-logo" />

                                <h1>
                                    Login
                                </h1>

                            </div>

                            <p>
                                Sign in to your Salo-Salo Table account.
                            </p>

                        </div>


                        <!-- LOGIN FORM -->

                        <form ng-submit="loginFunc()" novalidate>

                            <div class="input-field">

                                <i class="material-icons prefix">
                                    person
                                </i>

                                <input type="text"
                                       id="username"
                                       ng-model="username"
                                       required />

                                <label for="username">
                                    Username
                                </label>

                            </div>


                            <div class="input-field">

                                <i class="material-icons prefix">
                                    lock
                                </i>

                                <input type="password"
                                       id="password"
                                       ng-model="password"
                                       required />

                                <label for="password">
                                    Password
                                </label>

                            </div>


                            <div class="login-buttons">

                                <button type="submit"
                                        class="salo-button">

                                    Login

                                    <i class="material-icons right">
                                        login
                                    </i>

                                </button>


                                <button type="button"
                                        class="salo-button-outline"
                                        ng-click="clearLogin()">

                                    Clear

                                </button>

                            </div>

                        </form>


                        <div class="login-register center-align">

                            <p>

                                Don't have an account?

                                <a href="@Url.Action("Registration", "Account")">
                                    Register here
                                </a>

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="@Url.Content("~/Scripts/SaloSalo/module.js")"></script>
<script src="@Url.Content("~/Scripts/SaloSalo/service.js")"></script>
<script src="@Url.Content("~/Scripts/SaloSalo/controller.js")"></script>